#!/bin/sh
# git-ssh-sign: Wrapper script for Git SSH commit signing.
# Delegates to 1Password's op-ssh-sign if available,
# otherwise falls back to ssh-keygen (Git's default SSH signer).

OP_SSH_SIGN="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

if [ -x "$OP_SSH_SIGN" ]; then
    exec "$OP_SSH_SIGN" "$@"
else
    exec ssh-keygen "$@"
fi
